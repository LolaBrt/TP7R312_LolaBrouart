---
import * as Plot from "@observablehq/plot";
import penguins from "../../../data/penguins.json";
import PlotFigure from "../../../components/PlotFigure.astro";
import Layout from "../../../layouts/Layout.astro";

export function getStaticPaths() {
  const especes = [
    ...new Set(
      penguins.map((penguin) => penguin.species).filter((species) => species !== null),
    ),
  ];

  return especes.map((species) => ({
    params: {
      species,
    },
  }));
}

const { species } = Astro.params;

const filteredPenguins = penguins.filter((penguin) => penguin.species === species);

const plotOptions = {
  grid: true,
  marginLeft: 60,
  x: {
    label: "Longueur du bec (mm)",
  },
  y: {
    label: "Profondeur du bec (mm)",
  },
  title: `Manchots de l'espèce ${species}`,
  marks: [
    Plot.dot(filteredPenguins, {
      x: "culmen_length_mm",
      y: "culmen_depth_mm",
      fill: "species",
      r: 5,
      fillOpacity: 0.7,
      tip: true,
    }),
  ],
};
---

<Layout>
  <h1>Manchots de l'espèce {species}</h1>

  <p>
    {filteredPenguins.length} manchot(s) trouvé(s).
  </p>

  <PlotFigure options={plotOptions} />
</Layout>

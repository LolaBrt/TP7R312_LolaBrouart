---
import penguins from "../../../data/penguins.json";
import Layout from "../../../layouts/Layout.astro";

const especes = [
  ...new Set(
    penguins.map((penguin) => penguin.species).filter((species) => species !== null),
  ),
];
---

<Layout>
  <h1>Les manchots par espèce</h1>
  <div class="pb-20">
    <p>
      Nous verrons ici les différences de taille de bec entre les manchots de différentes races.
    </p>
    <p>Choisissez une espèce pour voir les manchots correspondants.</p>
  </div>

  <ul class="space-y-4 pb-40">
    {
      especes.map((species) => (
        <li>
          <a
            class="font-bold text-lg text-indigo transition-colors hover:text-orange-300"
            href={`/penguins/species/${species}`}
          >
            Voir les manchots de l'espèce {species}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
